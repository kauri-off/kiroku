<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity android:name=".MainActivity">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="${debugMenuShortcuts}" />
        </activity>
        <activity
            android:name=".debugmenu.DebugMenuActivity"
            android:exported="false"
            android:label="@string/debug_menu_title"
            android:launchMode="singleTop" />
        <activity
            android:name=".debugmenu.GalleryActivity"
            android:exported="false"
            android:label="@string/gallery_title" />
        <service
            android:name=".scenario.ScenarioTile"
            android:exported="true"
            android:icon="@drawable/ic_scenarios"
            android:label="@string/scenarios_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
