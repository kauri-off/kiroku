# tools/emu job: stopped by a signal
term_job() {
  rm -rf "${F:?}"/*
  env KIROKU_Q_SLOT=1 "$W/tools/emu" _job run "$@" > "$T/term.out" 2>&1 &
  local pid=$! t0
  for _ in {1..100}; do grep -qs -- "$wait_for" "$F/adb.log" "$T/term.out" && break; sleep 0.1; done
  t0=$SECONDS
  kill -TERM $pid
  wait $pid
  rc=$?
  took=$((SECONDS - t0))
  out=$(< "$T/term.out")
}
wait_for=cmd-started term_job sh -c 'sleep 1000 & echo $! > "$FAKE/cmd.child"; echo cmd-started; wait'
ok "emu job exits on TERM during the command" '[[ $rc == 143 && $took -le 6 ]]'
ok "  and stops the command, the emulator and the adb server" \
  'all_gone cmd.child emu.pid emu.child emu.escaped adb.server && [[ ! -e $AVDR/run-$port ]]'
FAKE_BOOT=never wait_for=sys.boot_completed term_job true
ok "emu job exits on TERM during boot and stops the emulator" \
  '[[ $rc == 143 ]] && all_gone emu.pid emu.child emu.escaped adb.server && [[ ! -e $AVDR/run-$port ]]'
FAKE_EMU_STUBBORN=1 wait_for=cmd-started term_job sh -c 'sleep 1000 & echo $! > "$FAKE/cmd.child"; echo cmd-started; wait'
ok "emu job kills an emulator that ignores TERM within the queue's grace" \
  '[[ $rc == 143 && $took -le 8 ]] && all_gone emu.pid emu.child emu.escaped && [[ ! -e $AVDR/run-$port ]]'
FAKE_EMU_NOKILL=1 wait_for=":: emu kill" term_job true
ok "emu job on TERM during its shutdown finishes it quickly" \
  '[[ $took -le 6 ]] && all_gone emu.pid emu.child emu.escaped adb.server && [[ ! -e $AVDR/run-$port ]]'

# tools/emu smoke outcomes
smoke() { job smoke "$T/app.apk"; }
