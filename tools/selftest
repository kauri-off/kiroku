# tools/q itself: every job below is a real unit of the systemd user manager that runs a fake command
if ! systemctl --user show-environment > /dev/null 2>&1; then
  echo "SKIP tools/q: no systemd user manager here, so the queue's own rules are not tested"
  echo "$fails failed"
  exit $((fails != 0))
fi
export XDG_STATE_HOME=$T/state
QS=$XDG_STATE_HOME/kiroku-queue
threads=16

conf() {
  local -A v=([budget_mib]=1000 [margin_mib]=100 [cpu_reserve]=0 [emu_slots]=2 [patience_s]=100 [force_s]=100
    [poll_s]=0.2 [stall_s]=100 [kill_grace_s]=1)
  local a k
  for a; do v[${a%%=*}]=${a#*=}; done
  {
    echo "[queue]"
    for k in "${!v[@]}"; do echo "$k = ${v[$k]}"; done
    printf '[%s]\nmem_mib = %s\nworkers = %s\nslot = %s\n' small 300 1 no big 800 1 no emu 300 1 yes test 600 3 no \
      check 300 5 no wide 1 $((threads / 2 + 1)) no alloc 100 1 no
  } > "$W/tools/q.conf"
}
avail() { printf 'MemAvailable: %s kB\nSwapFree: %s kB\n' $(($1 * 1024)) $((${2:-0} * 1024)) > "$T/meminfo"; }
q() { "$W/tools/q" "$@"; }
sub() { local kind=$1; shift; q submit --kind "$kind" -C "$W" -- "$@"; }
st() {
  python3 -c 'import json, sys
try: print(json.load(open(sys.argv[1])).get(sys.argv[2], ""))
except (OSError, ValueError): pass' "$QS/jobs/$1/status.json" "$2"
}
is() {
  local id=$1 key=$2 want=$3
  for _ in {1..80}; do [[ $(st "$id" "$key") == "$want" ]] && return 0; sleep 0.1; done
  echo "  ($id $key is '$(st "$id" "$key")', not '$want')"
  return 1
}
finished() {
  local id
  for id; do
    for _ in {1..300}; do case $(st "$id" state) in queued | running) sleep 0.1 ;; *) break ;; esac; done
  done
}
le() { python3 -c 'import sys; sys.exit(not float(sys.argv[1]) <= float(sys.argv[2]) + 0.01)' "$(st "$1" "$2")" "$(st "$3" "$4")"; }
drain() {
  local d
  for d in "$QS"/jobs/*/; do q kill "$(basename "$d")" > /dev/null 2>&1; done
}
printf '%s\n' "avd_root=$AVDR" "port_base=$port" "meminfo=$T/meminfo" cpus=16 lock_wait=1 boot_timeout=20 smoke_delay=0 \
  > "$W/tools/test-hooks"

