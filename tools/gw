#!/usr/bin/env bash
set -euo pipefail
USAGE="usage: tools/gw [--kind test|check] [--client-id] GRADLE_ARGS...   run Gradle as a queue job (default kind: test)
       tools/gw --wait ID                                       wait again for a job that is not finished
Gradle builds without the MAL client id (-Pkiroku.malClientId=), as CI does; --client-id builds with the machine's
own, as :data:recordMalAnswers needs. A -Pkiroku.malClientId among the arguments is used as given.
Run it inside its worktree. Gradle sees no device; device tasks run as: tools/emu run tools/gw TASK.
There a connected task fails (exit 1) when it ran no test or its result holds a failure. Device tasks are named in
full: an abbreviation that could be one is refused.
Waits up to 100 s, then prints the job's last 60 lines, the path of its full log and its memory peak.
Exit: Gradle's code (1 = failed); 75 not finished, 76 stalled, 125 job stopped, 2 refused (nothing ran)."
. "$(dirname "$0")/queue.sh"

case ${1:-} in
  '' | -h | --help) usage ;;
  --wait) [[ $# == 2 ]] || usage; qwait gw "$2" ;;
esac
kind=test client=0
while (($#)); do
  case $1 in
    --kind) [[ $# -ge 2 ]] || usage; kind=$2; shift 2 ;;
    --kind=*) kind=${1#--kind=}; shift ;;
    --client-id) client=1; shift ;;
    *) break ;;
  esac
done
case $kind in
  test | check) ;;
  *) die "--kind must be test or check, not '$kind'" ;;
esac
[[ $# -gt 0 ]] || usage
for a; do
  case $a in
    --kind | --kind=* | --client-id | --wait) die "$a must come first" ;;
    -p | --project-dir | --project-dir=*) die "$a is not allowed: tools/gw builds only its own worktree, $SELF" ;;
  esac
done

# Without --client-id the build has no client id, unless the arguments set the property themselves.
if ((!client)); then
  unset MAL_CLIENT_ID
  own=0 prop=0
  for a; do
    if ((prop)); then
      prop=0
      [[ $a != kiroku.malClientId && $a != kiroku.malClientId=* ]] || own=1
      continue
    fi
    case $a in
      -P | --project-prop) prop=1 ;;
      -Pkiroku.malClientId | -Pkiroku.malClientId=* | --project-prop=kiroku.malClientId | \
        --project-prop=kiroku.malClientId=*) own=1 ;;
    esac
  done
  ((own)) || set -- -Pkiroku.malClientId= "$@"
fi

# The device tasks among the arguments, by full name in any case; an abbreviation that could expand to one is refused.
device=() connected=0 skip=0 dry=0
for a; do
  if ((skip)); then skip=0 && continue; fi
  case $a in
    -x | --exclude-task | -P | -D | -I | --init-script | -g | --gradle-user-home | --include-build | \
      --project-cache-dir | --tests | --task | --configuration | --dependency | --console | --warning-mode | \
      --priority | -M | --write-verification-metadata | -F | --dependency-verification) skip=1 && continue ;;
    -m | --dry-run) dry=1 && continue ;;
    -*) continue ;;
  esac
  t=${a##*:} w=${a##*:}
  w=${w%%[A-Z]*}
  case ${t,,} in
    connected*) device+=("$a") connected=1 ;;
    install* | uninstall*) device+=("$a") ;;
    *) for d in connected install uninstall; do
      [[ -z $w || $d != "${w,,}"* ]] ||
        die "name $a in full: it could be the device task ${d}…, which is checked by name"
    done ;;
  esac
done

if in_emu_job; then
  cd "$SELF"
  export JAVA_TOOL_OPTIONS="-Djava.io.tmpdir=$TMPDIR${JAVA_TOOL_OPTIONS:+ $JAVA_TOOL_OPTIONS}"
  ((connected && !dry)) || exec "$SELF/gradlew" --no-daemon --max-workers=2 "$@"
  # AGP reports success when its test engine cannot reach the device, so the results are checked here.
  stamp=$(mktemp)
  rc=0
  "$SELF/gradlew" --no-daemon --max-workers=2 "$@" || rc=$?
  ((rc == 0)) || exit "$rc"
  total=0 files=0
  count() { n=$(grep -o -m1 " $1=\"[0-9]*\"" "$2" | tr -dc 0-9) || true; echo "${n:-0}"; }
  while IFS= read -r -d '' f; do
    n=$(count tests "$f") bad=$(($(count failures "$f") + $(count errors "$f")))
    files=$((files + 1)) total=$((total + n))
    if ((n == 0)); then
      echo "DEVICE TESTS FAILED: ${f#"$SELF"/} ran no test: the device could not be reached, or no test was found" \
        "(see the output above)"
      exit 1
    fi
    if ((bad > 0)); then
      echo "DEVICE TESTS FAILED: ${f#"$SELF"/} has failures or errors although Gradle passed:" \
        "the instrumentation did not complete, for example it crashed (see the file)"
      exit 1
    fi
  done < <(find "$SELF" -path "$SELF/.git" -prune -o -path '*/build/outputs/androidTest-results/connected/*' \
    -name 'TEST-*.xml' -newer "$stamp" -print0)
  if ((files == 0)); then
    echo "DEVICE TESTS FAILED: the connected task wrote no test result, so no device test ran"
    exit 1
  fi
  if ((total == 1)); then w=test; else w=tests; fi
  echo "tools/gw: $total device $w ran on $ANDROID_SERIAL, none failed ($files result files)"
  exit 0
fi
((${#device[@]} == 0)) || die "Gradle sees no device here: run it as tools/emu run tools/gw ${device[0]}"

qsubmit gw "$kind" sh -c 'export ANDROID_SERIAL=kiroku-no-device ANDROID_ADB_SERVER_PORT=15599 '"$ADB_ISOLATION"'
unset '"$ADB_REDIRECTS"'
export JAVA_TOOL_OPTIONS="-Djava.io.tmpdir=$TMPDIR${JAVA_TOOL_OPTIONS:+ $JAVA_TOOL_OPTIONS}"
./gradlew --no-daemon --max-workers="$KIROKU_Q_WORKERS" "$@"
rc=$?
case $rc in 2 | 69 | 75 | 76 | 125) echo "tools/gw: Gradle exited $rc, reported as 1"; rc=1 ;; esac
exit $rc' gradlew "$@"
