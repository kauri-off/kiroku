#!/usr/bin/env bash
set -euo pipefail
USAGE="usage: tools/gw [--kind test|check] GRADLE_ARGS...   run Gradle as a queue job (default kind: test)
       tools/gw --wait ID                           wait again for a job that is not finished
Run it inside its worktree. Gradle sees no device; device tasks run as: tools/emu run tools/gw TASK.
Waits up to 100 s, then prints the job's last 60 lines, the path of its full log and its memory peak.
Exit: Gradle's code (1 = failed); 75 not finished, 76 stalled, 125 job stopped, 2 refused (nothing ran)."
. "$(dirname "$0")/queue.sh"

case ${1:-} in
  '' | -h | --help) usage ;;
  --wait) [[ $# == 2 ]] || usage; qwait gw "$2" ;;
esac
kind=test
case $1 in
  --kind) [[ $# -ge 2 ]] || usage; kind=$2; shift 2 ;;
  --kind=*) kind=${1#--kind=}; shift ;;
esac
case $kind in
  test | check) ;;
  *) die "--kind must be test or check, not '$kind'" ;;
esac
[[ $# -gt 0 ]] || usage
for a; do
  case $a in
    --kind | --kind=* | --wait) die "$a must come first" ;;
    -p | --project-dir | --project-dir=*) die "$a is not allowed: tools/gw builds only its own worktree, $SELF" ;;
  esac
done

if in_emu_job; then
  cd "$SELF"
  export JAVA_TOOL_OPTIONS="-Djava.io.tmpdir=$TMPDIR${JAVA_TOOL_OPTIONS:+ $JAVA_TOOL_OPTIONS}"
  exec "$SELF/gradlew" --no-daemon --max-workers=2 "$@"
fi
for a; do
  if [[ $a != -* && ${a##*:} =~ ^(install|uninstall|connected)[A-Z] ]]; then
    die "Gradle sees no device here: run it as tools/emu run tools/gw $a"
  fi
done

qsubmit gw "$kind" sh -c 'export ANDROID_SERIAL=kiroku-no-device ANDROID_ADB_SERVER_PORT=15599 '"$ADB_ISOLATION"'
unset '"$ADB_REDIRECTS"'
export JAVA_TOOL_OPTIONS="-Djava.io.tmpdir=$TMPDIR${JAVA_TOOL_OPTIONS:+ $JAVA_TOOL_OPTIONS}"
./gradlew --no-daemon --max-workers="$KIROKU_Q_WORKERS" "$@"
rc=$?
case $rc in 2 | 69 | 75 | 76 | 125) echo "tools/gw: Gradle exited $rc, reported as 1"; rc=1 ;; esac
exit $rc' gradlew "$@"
